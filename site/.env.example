# Copy this file to .env.local and fill in the real values.

# Canonical public URL of the marketing site (no trailing slash).
# Used by sitemap.ts and robots.ts. Defaults to the Vercel preview URL if unset.
NEXT_PUBLIC_SITE_URL=https://omnipulseid.vercel.app

# URL of the OmniPulse platform app (sign-in, dashboard).
# When set, primary CTAs link here. When unset, they degrade to a mailto: request.
NEXT_PUBLIC_PLATFORM_URL=https://app.omnipulse.id

# Contact email address surfaced in mailto: fallback CTAs and the footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@omnipulse.id
